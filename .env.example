# ── SMTP ──────────────────────────────────────────────────────────────
# Cuenta desde la que SALEN los correos del formulario. Puede ser la misma
# que usa imationgroup mientras no exista buzón propio del dominio.
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_USER=info@loureirosoluciones.com
SMTP_PASSWORD=
SMTP_FROM=info@loureirosoluciones.com
SMTP_USE_TLS=true

# ── Destinatario ──────────────────────────────────────────────────────
# Buzón donde aterrizan las solicitudes de presupuesto.
SUPPORT_EMAIL=info@loureirosoluciones.com

# ── CORS ──────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://loureirosoluciones.com,https://www.loureirosoluciones.com,http://localhost:8080
