# ── SMTP ──────────────────────────────────────────────────────────────
# Cuenta desde la que SALEN los correos del formulario. Puede ser la misma
# que usa imationgroup mientras no exista buzón propio del dominio.
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_USER=contacto@loureirosoluciones.es
SMTP_PASSWORD=
SMTP_FROM=contacto@loureirosoluciones.es
SMTP_USE_TLS=true

# ── Destinatario ──────────────────────────────────────────────────────
# Buzón donde aterrizan las solicitudes de presupuesto.
SUPPORT_EMAIL=contacto@loureirosoluciones.es

# ── CORS ──────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://loureirosoluciones.es,https://www.loureirosoluciones.es,http://localhost:8080
