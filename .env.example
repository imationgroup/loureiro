# ── SMTP ──────────────────────────────────────────────────────────────
# Cuenta desde la que SALEN los correos del formulario. Puede ser la misma
# que usa imationgroup mientras no exista buzón propio del dominio.
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_USER=contacto@loureirosoluciones.es
SMTP_PASSWORD=
SMTP_FROM=contacto@loureirosoluciones.es
SMTP_USE_TLS=true

# ── Destinatario ──────────────────────────────────────────────────────
# Buzón donde aterrizan las solicitudes de presupuesto.
SUPPORT_EMAIL=contacto@loureirosoluciones.es

# ── Aviso de solicitud pendiente ──────────────────────────────────────
# Correo corto de "tienes una solicitud pendiente" con el enlace al panel.
# No lleva datos del cliente. Admite varias direcciones separadas por comas.
# Vacío = no se manda. Tras cambiarlo: docker compose up -d --force-recreate
AVISO_EMAIL=

# ── CORS ──────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://loureirosoluciones.es,https://www.loureirosoluciones.es,http://localhost:8080

# ── Panel de gestión ──────────────────────────────────────────────────
# La contraseña NUNCA se guarda en claro, solo su hash. No edites estas
# dos líneas a mano: genéralas con
#     python3 scripts/set-admin-password.py
ADMIN_EMAIL=contacto@loureirosoluciones.es
ADMIN_PASSWORD_HASH=
# Horas que dura la sesión del panel antes de pedir login otra vez
SESSION_HOURS=12

# ── Datos de la empresa ───────────────────────────────────────────────
# NIF/CIF de la empresa. Sale en los PDF (presupuestos, proformas y facturas)
# y en el aviso legal y la política de privacidad. Sin él no se deja descargar
# una factura: una factura sin el NIF del emisor no es válida.
# Tras cambiarlo, recrea el contenedor para que lo lea:
#     docker compose up -d --force-recreate
EMPRESA_NIF=
